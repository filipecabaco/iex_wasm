# Generated by `mix beam_box.build`. Builds the release on 32-bit Alpine, which is what v86 runs.
FROM <%= @alpine %> AS build

RUN apk add --no-cache elixir erlang28 erlang28-dev build-base git<%= for pkg <- @build_apk do %> <%= pkg %><% end %>

ENV MIX_ENV=prod LANG=C.UTF-8
WORKDIR /src
RUN mix local.hex --force && mix local.rebar --force

COPY <%= Enum.join(@manifest, " ") %> ./
<%= for dir <- @config_dirs do %>COPY <%= dir %> <%= dir %>
<% end %>RUN mix deps.get --only prod && mix deps.compile

<%= for dir <- @source_dirs do %>COPY <%= dir %> <%= dir %>
<% end %>RUN mix release <%= @release %> --overwrite --path /release

# The release bundles its own ERTS, so the runtime image only needs the system libraries it links
FROM <%= @alpine %>

RUN apk add --no-cache libstdc++ libgcc ncurses-libs openssl zlib<%= for pkg <- @apk do %> <%= pkg %><% end %>

COPY --from=build /release /app
