<!DOCTYPE html>
<!-- Generated by assets/cards.exs: the poster for the <%= card["name"] %> X player card, what a
     post shows before someone taps it. Capture at a 480x480 viewport, deviceScaleFactor 2, into
     site/x/<%= card["dir"] %>/poster.png. -->
<html lang="en">
<head>
<meta charset="utf-8">
<title>snowglobe <%= h.(card["name"]) %> poster</title>
<style>
  @font-face { font-family: "Switzer"; src: url("../../site/fonts/Switzer-Variable.woff2") format("woff2"); font-weight: 100 900; }
  @font-face { font-family: "Fragment Mono"; src: url("../../site/fonts/FragmentMono-Regular.woff2") format("woff2"); }
  html, body { margin: 0; width: 480px; height: 480px; overflow: hidden; }
  body { background: #0b0b0c; color: #e9e9e4; font-family: "Switzer", sans-serif; -webkit-font-smoothing: antialiased;
    padding: 30px 30px 26px; box-sizing: border-box; display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: minmax(0, 1fr); }
  .top { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 14px; border-bottom: 1px solid #e9e9e4; }
  .mark { font-weight: 650; font-size: 19px; letter-spacing: -.02em; }
  .mark i { display: inline-block; width: .5em; height: .5em; border-radius: 50%; background: #ff5a2e; margin-left: .12em; vertical-align: .04em; }
  .live { font-size: 14px; color: #a2a29c; }
  h1 { font-size: 34px; line-height: 1; letter-spacing: -.03em; font-weight: 620; margin: 22px 0 18px; }
  /* The run page's own terminal font: it has every box-drawing and block glyph at cell width, so
     tables and the Game of Life line up; no ligatures, since this is code */
  pre { margin: 0; font: 400 12.5px/1.24 ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; color: #e9e9e4;
    overflow: hidden; font-variant-ligatures: none; font-feature-settings: "liga" 0, "calt" 0; }
  body > div:nth-child(2) { min-width: 0; }
  .p { color: #8d8d88; }
  .b { font-weight: 700; }
  .foot { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; padding-top: 14px; border-top: 1px solid #2b2b29; }
  .foot b { font-weight: 600; }
  .foot span { color: #a2a29c; }
  .foot b::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 9px; border-radius: 50%; background: #ff5a2e; vertical-align: .08em; }
</style>
</head>
<body>
  <div class="top"><span class="mark">snowglobe<i></i></span><span class="live">no server · in your browser</span></div>
  <div>
    <h1><%= h.(card["name"]) %>,<br>running in this post.</h1>
<pre><%= lines %></pre>
  </div>
  <div class="foot"><b>Tap to boot it</b><span>Linux on x86, in WebAssembly</span></div>
</body>
</html>
