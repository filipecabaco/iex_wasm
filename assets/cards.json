{
  "base": "https://filipecabaco.github.io/snowglobe/",
  "note": "One X player card per demo: assets/cards.exs writes site/card/<dir>/index.html and the poster sources from this. Poster lines are real output from each demo's recorded run; a line starting with ! is bold, the demo's prompt is dimmed.",
  "cards": [
    {
      "dir": "iex",
      "name": "Elixir IEx",
      "prompt": "iex(",
      "about": "Elixir and the BEAM, just IEx",
      "lines": [
        "iex(1)> Enum.map(1..5, &(&1 * &1))",
        "[1, 4, 9, 16, 25]",
        "iex(2)> for x <- 1..3, y <- [:a, :b], do: {x, y}",
        "[{1, :a}, {1, :b}, {2, :a}, {2, :b}, {3, :a}, {3, :b}]",
        "iex(4)> pid = spawn(fn ->",
        "...(4)>   receive do",
        "...(4)>     msg -> IO.inspect(msg, label: \"got\")",
        "...(4)>   end",
        "...(4)> end)",
        "#PID<0.111.0>",
        "iex(5)> send(pid, {:hello, \"from a browser tab\"})",
        "{:hello, \"from a browser tab\"}",
        "got: {:hello, \"from a browser tab\"}"
      ]
    },
    {
      "dir": "postgres",
      "name": "PostgreSQL",
      "prompt": "postgres",
      "about": "A PostgreSQL 18 server with psql",
      "lines": [
        "postgres=# SELECT name, moons, rank()",
        "postgres-#   OVER (ORDER BY moons DESC)",
        "postgres-#   FROM planets LIMIT 5;",
        "!  name   | moons | rank",
        "---------+-------+------",
        " Saturn  |   146 |    1",
        " Jupiter |    95 |    2",
        " Uranus  |    28 |    3",
        " Neptune |    16 |    4",
        " Mars    |     2 |    5",
        "(5 rows)"
      ]
    },
    {
      "dir": "elixir",
      "name": "Elixir + Postgres",
      "prompt": "iex(",
      "about": "IEx and a PostgreSQL 18 server",
      "lines": [
        "iex(1)> sql \"SHOW server_version\"",
        "!server_version",
        "──────────────",
        "18.6",
        "iex(2)> sql \"SELECT app, count(*) FROM modules …\"",
        "!app      │ count",
        "─────────┼──────",
        "elixir   │ 272",
        "kernel   │ 103",
        "ecto     │ 100",
        "postgrex │ 95"
      ]
    },
    {
      "dir": "python",
      "name": "Python + Rich",
      "prompt": ">>>",
      "about": "CPython 3.14 with Rich",
      "lines": [
        ">>> print(\"[bold magenta]hello[/] from [green]Rich[/]\")",
        "!hello from Rich",
        ">>> t = Table(\"language\", \"year\")",
        ">>> t.add_row(\"Python\", \"1991\"); t",
        "┏━━━━━━━━━━┳━━━━━━┓",
        "┃ language ┃ year ┃",
        "┡━━━━━━━━━━╇━━━━━━┩",
        "│ Python   │ 1991 │",
        "└──────────┴──────┘"
      ]
    },
    {
      "dir": "typescript",
      "name": "TypeScript + Zod",
      "prompt": "> ",
      "about": "Node 24 and tsx, with Zod",
      "lines": [
        "> User.parse({ name: \"Ada\", email: \"ada@example.com\" })",
        "{ name: 'Ada', email: 'ada@example.com' }",
        "> User.safeParse({ name: \"\", email: \"nope\" })",
        "...   .error?.issues.map((i) => i.message)",
        "[",
        "  'Too small: expected string to have >=1 characters',",
        "  'Invalid email address'",
        "]",
        "> Repo.parse(await (await fetch(…copy/v86)).json())",
        "{ full_name: 'copy/v86', … }"
      ]
    },
