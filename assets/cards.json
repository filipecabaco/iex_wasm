    {
      "dir": "java",
      "name": "Java + Gson",
      "prompt": "jshell>",
      "about": "jshell on OpenJDK 11, with Gson",
      "lines": [
        "jshell> gson.toJson(new Planet(\"Mars\", 0.107, 2))",
        "$1 ==> \"{\\n  \\\"name\\\": \\\"Mars\\\", …}\"",
        "jshell> gson.fromJson(\"{\\\"name\\\": \\\"Jupiter\\\",",
        "   ...>   \\\"massEarths\\\": 317.8}\", Planet.class)",
        "$2 ==> Jupiter (317.8 Earth masses, 0 moons)",
        "jshell> JsonParser.parseString(\"{\\\"a\\\": [1, 2, 3]}\")",
        "   ...>   .getAsJsonObject().get(\"a\")",
        "$3 ==> [1,2,3]"
      ]
    },
    {
      "dir": "curl",
      "name": "curl + jq",
      "prompt": "~ $",
      "about": "curl and jq, online through your browser",
      "lines": [
        "~ $ curl -sS https://api.github.com/zen",
        "Anything added dilutes everything else.",
        "~ $ curl -sS …/repos/copy/v86 | jq '{name, language}'",
        "{",
        "  \"name\": \"copy/v86\",",
        "  \"language\": \"JavaScript\"",
        "}",
        "~ $ curl -sS …/users/copy/repos | jq -r '.[].name'",
