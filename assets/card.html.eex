<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Generated by assets/cards.exs from assets/cards.json: edit those, not this -->
  <title><%= h.(card["name"]) %>, sandboxed in your browser · snowglobe</title>
  <meta name="description" content="<%= h.(card["about"]) %>: Linux on an x86 CPU emulated in WebAssembly, right in your browser. No server.">
  <!-- An X player card: X loads twitter:player in an iframe inside the post. The crawler reads
       these tags from static HTML, and every URL must be absolute https -->
  <meta name="twitter:card" content="player">
  <meta name="twitter:title" content="<%= h.(card["name"]) %>, sandboxed in your browser">
  <meta name="twitter:description" content="<%= h.(card["about"]) %>: Linux on an x86 CPU emulated in WebAssembly. Tap to boot it. No server.">
  <meta name="twitter:image" content="<%= base %>x/<%= card["dir"] %>/poster.png">
  <meta name="twitter:image:alt" content="<%= h.(card["name"]) %>: real output recorded from this run">
  <meta name="twitter:player" content="<%= base %><%= card["dir"] %>/?embed">
  <meta name="twitter:player:width" content="480">
  <meta name="twitter:player:height" content="480">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="snowglobe">
  <meta property="og:title" content="<%= h.(card["name"]) %>, sandboxed in your browser">
  <meta property="og:description" content="<%= h.(card["about"]) %>: Linux on an x86 CPU emulated in WebAssembly. No server.">
  <meta property="og:image" content="<%= base %>x/<%= card["dir"] %>/poster.png">
  <meta property="og:url" content="<%= base %>x/<%= card["dir"] %>/">
  <link rel="canonical" href="<%= base %>#<%= card["dir"] %>">
  <style>
    body { margin: 0; padding: 32px 20px; background: #0d0d0c; color: #ecece8; font: 16px/1.5 system-ui, sans-serif; }
    a { color: inherit; }
  </style>
</head>
<body>
  <!-- People who open the link itself (not the card) go to the run on the demo page -->
  <p>Opening the <%= h.(card["name"]) %> run… <a href="../../#<%= card["dir"] %>">Continue to snowglobe</a></p>
  <script>location.replace("../../#<%= card["dir"] %>");</script>
</body>
</html>
