<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <title>{{.Title}}</title>
  <meta name="description" content="{{.Title}}: a real program on Linux, running on a 64-bit ARM CPU emulated in WebAssembly in this browser tab. Built with snowglobe; no server.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{.Title}}">
  <meta property="og:description" content="A real program on Linux, running on a 64-bit ARM CPU emulated in WebAssembly in your browser tab. No server.">
  <meta name="twitter:card" content="summary">
  <link rel="stylesheet" href="xterm/xterm.css">
  <style>
    html, body { height: 100%; margin: 0; background: #000; overscroll-behavior: none; }
    /* Pinned to the visual viewport, so the on-screen keyboard shrinks the terminal instead of
       covering its prompt (--vvh and --vvt follow window.visualViewport) */
    body { position: fixed; left: 0; right: 0; top: var(--vvt, 0px); height: var(--vvh, 100%);
      display: flex; flex-direction: column; font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      padding: 0 env(safe-area-inset-right, 0px) 0 env(safe-area-inset-left, 0px); box-sizing: border-box; }
    /* The strip: what this window is, and that it's a sandbox */
    #strip { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: .25rem 1.25rem;
      padding: calc(.45rem + env(safe-area-inset-top, 0px)) .75rem .45rem;
      background: #fff; color: #0d0d0d; border-bottom: 1px solid #0d0d0d; }
    #strip .name { font-weight: 700; }
    #strip .facts { color: #5a5a57; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    #status { font-variant-numeric: tabular-nums; white-space: nowrap; }
    #strip .end { display: inline-flex; align-items: baseline; gap: .6rem; white-space: nowrap; }
    /* Narrow: name and status share the first line, the facts take the second */
    @media (max-width: 640px) {
      #strip { grid-template-columns: minmax(0, 1fr) auto; }
      #strip .name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      #strip .facts { grid-row: 2; grid-column: 1 / -1; }
    }
    #status::before { content: ""; display: inline-block; width: .55em; height: .55em; margin-right: .45em;
      border-radius: 50%; background: #c48a1e; vertical-align: .05em; }
    #status[data-state="ready"]::before { background: #d6300c; animation: live 2s ease-in-out infinite; }
    @keyframes live { 50% { opacity: .35; } }
    @media (prefers-reduced-motion: reduce) { #status[data-state="ready"]::before { animation: none; } }
    /* The terminal is as wide as the screen: the guest is told its size, so what the app prints
       from here wraps to it, and full-screen apps redraw for it */
    #terminal { flex: 1; min-height: 0; padding: 4px; overflow: hidden; }
    /* Location, save state and Save now never hide in a menu. The menu overlays the terminal. */
    #workspace-bar { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between;
      gap: 12px; padding: 10px 12px; background: #161615; color: #e9e9e4; border-bottom: 1px solid #3b3b39; }
    [hidden] { display: none !important; }
    .workspace-info { min-width: 0; flex: 1; }
    .save-state, .save-meta, .workspace-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .save-state { margin-bottom: 3px; }
    #session-status { font-weight: 600; }
    #session-status[data-error="true"], #session-help { color: #ff9e80; }
    #session-status[data-working="true"]::before { content: ""; display: inline-block; width: .7em; height: .7em;
      margin-right: .6em; border: 2px solid #555; border-top-color: #e9e9e4; border-radius: 50%;
      vertical-align: -.1em; animation: saving .8s linear infinite; }
    @keyframes saving { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { #session-status[data-working="true"]::before { animation: none; } }
    #session-changes { color: #ffd18a; }
    .save-meta, #session-hint { color: #aaa; font-size: 11px; overflow-wrap: anywhere; }
    #session-last-save::before { content: "· "; }
    #session-hint { margin: 3px 0 0; }
    .workspace-toolbar { flex-shrink: 0; flex-wrap: nowrap; }
    #sessions { position: relative; }
    #sessions summary { cursor: pointer; }
    #sessions > summary { list-style: none; padding: 7px 9px; border: 1px solid #3b3b39; border-radius: 4px; }
    #sessions > summary::-webkit-details-marker { display: none; }
    #sessions > summary::after { content: " ▾"; color: #aaa; }
    #sessions > summary:hover, #sessions[open] > summary { background: #252524; }
    #session-controls { position: absolute; top: calc(100% + 8px); right: 0; width: 310px;
      max-width: calc(100vw - 52px); max-height: min(70vh, 600px); overflow: auto;
      padding: 14px; background: #161615; border: 1px solid #3b3b39; border-radius: 8px;
      box-shadow: 0 12px 36px #0009; }
    #sessions p { margin: 8px 0; }
    #sessions .note { color: #aaa; font-size: 11px; }
    .workspace-actions { display: grid; gap: 6px; }
    #workspace-bar button, #sessions select, #session-filename, .workspace-import { font: inherit; color: inherit;
      border: 1px solid #3b3b39; background: #222221; border-radius: 4px; padding: 7px 9px; text-align: left; }
    #workspace-bar button, #sessions select, .workspace-import { cursor: pointer; }
    #session-save { background: #e9e9e4 !important; color: #161615 !important; }
    #workspace-bar button:hover, .workspace-import:hover { filter: brightness(1.15); }
    #workspace-bar :disabled, .workspace-import:has(input:disabled) { opacity: .45; cursor: default; }
    #workspace-bar :focus-visible, .workspace-import:focus-within { outline: 2px solid #e9e9e4; outline-offset: 2px; }
    .workspace-import { position: relative; }
    .workspace-import input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    #sessions .danger { color: #ff9e80; }
    .workspace-section { margin-top: 14px; padding-top: 12px; border-top: 1px solid #3b3b39; }
    .workspace-section .workspace-actions { margin-top: 10px; }
    #sessions label { display: grid; gap: 5px; color: #aaa; }
    #sessions select, #session-filename { width: 100%; min-width: 0; box-sizing: border-box; }
    #session-folder-location, #session-detail { overflow-wrap: anywhere; }
    #terminal-wrap { position: relative; display: flex; flex: 1; min-height: 0; }
    #session-paused { position: absolute; inset: 0; display: grid; place-items: center; padding: 20px;
      background: #000b; color: #eee; text-align: center; z-index: 1; }
    #session-paused p { margin: 6px 0 0; }
    @media (max-width: 640px) {
      #workspace-bar { flex-wrap: wrap; gap: 8px; padding: 8px; }
      .workspace-info { flex-basis: 100%; }
      .workspace-toolbar { margin-left: auto; }
    }

    /* The keys a phone keyboard lacks, for touch screens only. Pressing one never takes focus
       from the terminal, so the keyboard stays up */
    #keys { display: none; gap: 5px; padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px)); overflow-x: auto;
      background: #0b0b0c; border-top: 1px solid #2b2b29; scrollbar-width: none; }
    #keys::-webkit-scrollbar { display: none; }
    @media (pointer: coarse) { .running #keys { display: flex; } }
    #keys button { flex: 1 1 0; min-width: 40px; max-width: 72px; height: 44px; padding: 0 6px; border-radius: 6px;
      border: 1px solid #2b2b29; background: #161615; color: #e9e9e4; font-family: inherit; font-size: 14px; font-weight: 500; line-height: 1;
      display: inline-flex; align-items: center; justify-content: center; touch-action: manipulation;
      -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
    #keys button:active { background: #2b2b29; }
    #keys button[aria-pressed="true"] { background: #d6300c; border-color: #d6300c; color: #fff; }
    #keys svg { width: 16px; height: 16px; }
    #keys .gap { flex: 0 1 12px; }
    @media (prefers-color-scheme: dark) {
      #strip { background: #0d0d0c; color: #ecece8; border-bottom-color: #2b2b29; }
      #strip .facts { color: #a2a29c; }
      #status[data-state="ready"]::before { background: #ff5a2e; }
      #keys button[aria-pressed="true"] { background: #ff5a2e; border-color: #ff5a2e; color: #0b0b0c; }
    }
    /* ?embed: the page hosting this run already says what it is */
    .embed #strip { display: none; }
  </style>
  <script src="xterm/xterm.js"></script>
  <script src="xterm/addon-fit.js"></script>
  <script src="armless/armless.js"></script>
  <script src="sessions.js"></script>
  <script src="session-ui.js"></script>
</head>
<body>
  <header id="strip">
    <span class="name">{{.Title}}</span>
    <span class="facts">sandboxed in this tab · no server · {{if eq .Network "fetch"}}HTTP(S) through your browser{{else}}no network{{end}}</span>
    <span class="end">
      <span id="status" role="status" data-state="loading">loading 0%</span>
    </span>
  </header>
  <div id="workspace-bar">
    <div class="workspace-info">
      <div class="save-state"><span id="session-status" role="status">Opening workspace…</span><span id="session-changes" hidden>Unsaved changes</span></div>
      <div class="save-meta"><span id="session-location">Save location: This browser</span><span id="session-last-save">No save yet</span></div>
      <p id="session-hint">Please wait while your workspace opens.</p>
    </div>
    <div class="workspace-toolbar">
      <button id="session-save" type="button">Save now</button>
      <details id="sessions">
        <summary>Save / restore</summary>
        <div id="session-controls">
          <label>Save / restore method
            <select id="session-method"><option value="browser">Browser — automatic</option><option value="backup">Backup file</option><option value="folder">Folder — automatic</option></select>
          </label>
          <p id="session-help" hidden></p>
          <div id="session-browser-options" class="workspace-actions">
            <p class="note">No setup needed. Use Save now for an immediate save.</p>
            <button id="session-browser" type="button" hidden>Switch automatic saves to this browser…</button>
          </div>
          <div id="session-backup-options" class="workspace-actions" hidden>
            <p class="note">Portable copies. This does not change autosave or its location. Downloaded files are never updated automatically.</p>
            <label>Backup filename<input id="session-filename" type="text" value="workspace.snowglobe" maxlength="120" autocomplete="off" spellcheck="false"></label>
            <button id="session-export" type="button">Download backup</button>
            <label class="workspace-import">Restore backup…<input id="session-import" type="file" accept=".snowglobe" aria-label="Restore backup"></label>
            <p class="note">Backups can contain passwords and private data. Keep them safe and restore only trusted files.</p>
          </div>
          <div id="session-folder-options" class="workspace-actions" hidden>
            <p id="session-folder-location">No folder selected.</p>
            <button id="session-folder" type="button">Choose folder…</button>
            <button id="session-reconnect" type="button" hidden>Reconnect folder</button>
            <p class="note">Automatic saves use two alternating files in the Snowglobe subfolder. Browsers expose the folder name, not its full OS path.</p>
          </div>
          <div class="workspace-section">
            <label>Autosave<select id="session-autosave"><option value="60000">1 minute (default)</option><option value="300000">5 minutes</option><option value="900000">15 minutes</option><option value="off">Off — Save now only</option></select></label>
            <p class="note">Large saves may use a longer interval to keep the terminal responsive.</p>
          </div>
          <details class="workspace-section">
            <summary>Saved workspaces</summary>
            <div class="workspace-actions">
              <label>Workspace<select id="session-list" aria-label="Saved workspaces"></select></label>
              <button id="session-open" type="button">Open selected workspace…</button>
              <button id="session-fresh" type="button">Start fresh…</button>
              <button id="session-new" type="button">New named workspace…</button>
              <button id="session-delete" class="danger" type="button">Delete this saved workspace…</button>
            </div>
            <p class="note">Starting fresh keeps previous saves. Only Delete removes one.</p>
          </details>
          <details class="workspace-section">
            <summary>Recovery</summary>
            <div class="workspace-actions"><button id="reset" type="button" title="Reload without deleting saved work">Reload without deleting saves…</button></div>
            <p class="note">Reload if the demo stops responding. Changes since the last save may be lost.</p>
          </details>
          <p id="session-detail" class="note">No saved version yet.</p>
        </div>
      </details>
    </div>
  </div>
  <div id="terminal-wrap">
    <div id="terminal"></div>
    <div id="session-paused" role="status" hidden><div><strong>Copying workspace…</strong><p>Terminal briefly paused. Please wait.</p></div></div>
  </div>
  <div id="keys" role="toolbar" aria-label="Keys missing from touch keyboards">
    <button type="button" data-send="esc">esc</button>
    <button type="button" data-send="tab">tab</button>
    <button type="button" data-ctrl aria-pressed="false">ctrl</button>
    <button type="button" data-send="ctrl-c" aria-label="Control C">^C</button>
    <span class="gap"></span>
    <button type="button" data-send="left" aria-label="Left"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5"/></svg></button>
    <button type="button" data-send="up" aria-label="Up, previous in history"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 10 8 5.5l4.5 4.5"/></svg></button>
    <button type="button" data-send="down" aria-label="Down, next in history"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 6 8 10.5 12.5 6"/></svg></button>
    <button type="button" data-send="right" aria-label="Right"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg></button>
  </div>
  <script>
  (async () => {
    const status = document.getElementById("status");
    document.getElementById("reset").addEventListener("click", () => {
      if (confirm("Reload this workspace? Changes since the last save may be lost. Your saved work is kept.")) forgetAndReload();
    });

    // Follow the visual viewport: on phones it shrinks when the keyboard opens, while the layout
    // viewport (and 100%) stays put behind it
    const viewport = window.visualViewport;
    function trackViewport() {
      if (!viewport) return;
      document.documentElement.style.setProperty("--vvh", viewport.height + "px");
      document.documentElement.style.setProperty("--vvt", viewport.offsetTop + "px");
    }
    viewport?.addEventListener("resize", trackViewport);
    viewport?.addEventListener("scroll", trackViewport);
    trackViewport();

    // Several CPUs share memory between Web Workers, which needs a cross-origin isolated page:
    // sw.js adds the headers for that, once it controls the page (one reload, the first time)
    const cpus = {{.CPUs}};
    const isolationKey = "snowglobe-isolate:" + new URL("./", location.href).pathname;
    let isolationNeeded = cpus > 1 && !crossOriginIsolated;
    if (isolationNeeded) {
      let tried = false;
      try { tried = sessionStorage.getItem(isolationKey) === "1"; } catch {}
      if ("serviceWorker" in navigator && !tried) {
        try { sessionStorage.setItem(isolationKey, "1"); } catch {}
        navigator.serviceWorker.register("sw.js")
          .then(() => navigator.serviceWorker.ready)
          .then(() => location.reload(), () => {});
      }
    } else {
      try { sessionStorage.removeItem(isolationKey); } catch {}
    }

    // Rendered by snowglobe. Everything below must match the snapshot (snowglobe-vm snapshot):
    // the same RAM size, CPUs and devices
    const sessions = new SnowglobeSessionUI({ build: {{.BuildID}}, memory: {{.MemoryMB}}, cpus, network: {{.Network}} });
    if (!isolationNeeded && !await sessions.prepare()) {
      status.textContent = "workspace needs attention";
      status.dataset.state = "error";
      document.getElementById("sessions").open = true;
      return;
    }
    const emulator = isolationNeeded ? null : new Armless({
      wasm: "armless/armless.wasm",
      wasm_smp: "armless/armless-smp.wasm",
      memory_mb: {{.MemoryMB}},
      cpus,
      filesystem: { json: "system/filesystem.json", baseurl: "system/filesystem/" },
      initial_state: sessions.initialState ?? "system/state.bin.zst",
      {{- if eq .Network "fetch"}}
      // The guest's HTTP(S) and WebSockets end in the machine (HTTPS with a CA made for this
      // site) and go out as this page's own fetch() and WebSocket
      network: { tls: "system/tls.json" },
      {{- end}}
      // The terminal is set up (and the screen replayed) before the guest runs
      autostart: false,
    });

    const embedded = new URLSearchParams(location.search).has("embed");
    if (embedded) document.documentElement.classList.add("embed");

    // Tell any snowglobe page on this origin (an index of several runs) what this window is doing
    const run = {
      embedded,
      id: crypto.randomUUID?.() ?? String(Math.random()).slice(2),
      title: document.title,
      path: location.pathname,
      state: "loading",
      progress: 0,
      openedAt: Date.now(),
      readyAt: null,
    };
    const runs = "BroadcastChannel" in window ? new BroadcastChannel("snowglobe-runs") : null;
    const announce = () => runs?.postMessage({ type: "run", run, at: Date.now() });
    runs?.addEventListener("message", ({ data }) => {
      if (data?.type === "hello") announce();
      if (data?.type === "close" && data.id === run.id) window.close();
    });
    setInterval(announce, 2000);
    addEventListener("pagehide", () => runs?.postMessage({ type: "run", run: { ...run, state: "closed" }, at: Date.now() }));
    announce();

    const setStatus = (state, text) => {
      run.state = state;
      status.dataset.state = state;
      status.textContent = text;
      announce();
    };

    if (isolationNeeded) {
      setStatus("loading", "isolating");
      if (!("serviceWorker" in navigator)) setStatus("error", "needs a browser with service workers");
    }

    emulator?.on("progress", (e) => {
      if (e.file.endsWith("state.bin.zst") && e.total) {
        run.progress = Math.round((e.loaded / e.total) * 100);
        setStatus("loading", `loading ${run.progress}%`);
      }
    });
    emulator?.on("error", (error) => {
      // A stale copy (an offline cache from an earlier build, served by an older service worker)
      // doesn't match this page: start over from the network, once
      let retried = false;
      try { retried = sessionStorage.getItem("snowglobe-refreshed:" + sessions.scope) === "1"; } catch {}
      if (!retried) {
        try { sessionStorage.setItem("snowglobe-refreshed:" + sessions.scope, "1"); } catch {}
        setStatus("loading", "refreshing");
        forgetAndReload();
        return;
      }
      sessions.blocked = true;
      sessions.message("Workspace could not start", true, "Your saves are kept. Choose Backup file to download a saved copy, or open Saved workspaces to start fresh.", error.message);
      sessions.controls();
      setStatus("error", `failed: ${error.message || error}`);
    });
    emulator?.on("started", () => { try { sessionStorage.removeItem("snowglobe-refreshed:" + sessions.scope); } catch {} });
    emulator?.on("stop", ({ reason }) => setStatus("stopped", reason === "poweroff" ? "powered off" : `stopped (${reason})`));

    // The app's console output up to the snapshot, so the terminal shows what it printed
    const screen = sessions.replay ? Promise.resolve(null) : fetch("system/console.bin")
      .then((r) => (r.ok ? r.arrayBuffer() : null)).catch(() => null);

    emulator?.ready.then(async () => {
      run.readyAt = Date.now();
      document.documentElement.classList.add("running");

      const term = new Terminal({ cursorBlink: true, scrollback: 5000, allowProposedApi: false });
      term.open(document.getElementById("terminal"));
      // A terminal is not prose: no autocorrect, capitals or suggestions from touch keyboards
      const field = term.textarea;
      if (field) {
        for (const [k, v] of Object.entries({ autocapitalize: "off", autocorrect: "off", autocomplete: "off", spellcheck: "false" })) field.setAttribute(k, v);
        field.setAttribute("enterkeyhint", "send");
      }
      // Replay the app's screen at the size it was drawn at, so the terminal is exactly what the
      // app (a full-screen UI, a line editor) last drew; then fit it to the window and tell the
      // guest, and the app redraws for the new size as it would in any resized terminal
      if (matchMedia("(max-width: 640px)").matches) term.options.fontSize = 13;
      const fit = new FitAddon.FitAddon();
      term.loadAddon(fit);
      let pendingResize = false;
      const resize = () => {
        if (sessions.captureBusy) { pendingResize = true; return; }
        pendingResize = false;
        fit.fit();
        sessions.resize(term.cols, term.rows);
        emulator.console_resize(term.cols, term.rows);
      };
      {{- if .ConsoleCols}}
      term.resize({{.ConsoleCols}}, {{.ConsoleRows}});
      {{- else}}
      fit.fit();
      {{- end}}
      if (sessions.replay) {
        for (const event of sessions.replay) {
          if (event.bytes) term.write(event.bytes);
          else {
            await new Promise(resolve => term.write("", resolve));
            term.resize(event.cols, event.rows);
          }
        }
        await new Promise(resolve => term.write("", resolve));
      } else {
        sessions.resize(term.cols, term.rows);
        const replay = await screen;
        if (replay) {
          const bytes = new Uint8Array(replay);
          sessions.record(bytes);
          await new Promise(resolve => term.write(bytes, resolve));
        }
      }
      emulator.on("console", (bytes) => { sessions.record(bytes); term.write(bytes); });
      window.addEventListener("resize", resize);
      viewport?.addEventListener("resize", resize);
      // Keep the guest's terminal size in sync with viewport and layout changes.
      const terminalSize = new ResizeObserver(resize);
      terminalSize.observe(document.getElementById("terminal"));
      resize();

      // Input is queued in the machine until the guest takes it: nothing typed or pasted is lost
      term.onData((data) => { if (sessions.input()) emulator.console_input(withCtrl(data)); });
      keyBar(term);
      emulator.run();
      setStatus("ready", "running");
      term.focus();
      sessions.attach(emulator, term, () => { if (pendingResize) resize(); });
      // Request eviction protection, but never assume it is granted.
      navigator.storage?.persist?.().catch(() => {});

      preloadWarmPack().catch(() => {});
    }).catch(error => {
      sessions.blocked = true;
      sessions.message("Workspace could not start", true, "Your saves are kept. Choose Backup file to download a saved copy, or open Saved workspaces to start fresh.", error.message);
      sessions.controls();
      setStatus("error", `failed: ${error.message || error}`);
    });

    // The guest's files are fetched one blocking request at a time the first time each is read.
    // warm.pack bundles the files the app is most likely to need so they arrive in a single
    // background download and are in the machine before the guest asks for them.
    async function preloadWarmPack() {
      const response = await fetch("system/warm.pack");
      if (!response.ok) return;
      const pack = new Uint8Array(await response.arrayBuffer());
      const indexSize = new DataView(pack.buffer).getUint32(0, true);
      const index = JSON.parse(new TextDecoder().decode(pack.subarray(4, 4 + indexSize)));

      let offset = 4 + indexSize;
      for (const [name, , length] of index) {
        const blob = pack.subarray(offset, offset + length);
        offset += length;
        if (emulator.has_blob(name)) continue; // the guest already loaded it
        emulator.provide_blob(name, blob);
        // Yield between files so typing stays responsive while the cache fills
        await new Promise((resolve) => setTimeout(resolve, 0));
      }
    }

    // The touch key bar. ctrl is sticky: it applies to the next key typed on the keyboard
    let ctrlArmed = false;
    function keyBar(term) {
      const ctrl = document.querySelector("#keys [data-ctrl]");
      const arm = (on) => {
        ctrlArmed = on;
        ctrl.setAttribute("aria-pressed", String(on));
      };
      const arrow = (letter) => () => (term.modes.applicationCursorKeysMode ? "\x1bO" : "\x1b[") + letter;
      const keys = {
        esc: () => "\x1b", tab: () => "\t", "ctrl-c": () => "\x03",
        up: arrow("A"), down: arrow("B"), right: arrow("C"), left: arrow("D"),
      };
      document.getElementById("keys").addEventListener("pointerdown", (event) => {
        const button = event.target.closest("button");
        if (!button) return;
        event.preventDefault(); // keep focus (and the keyboard) on the terminal
        if (button.hasAttribute("data-ctrl")) return arm(!ctrlArmed);
        if (sessions.input()) emulator.console_input(keys[button.dataset.send]());
        arm(false);
        term.focus();
      });
    }

    // ctrl + a letter (or @[\]^_) is that character's control code
    function withCtrl(data) {
      if (!ctrlArmed || data.length !== 1) return data;
      ctrlArmed = false;
      document.querySelector("#keys [data-ctrl]")?.setAttribute("aria-pressed", "false");
      const code = data.toUpperCase().charCodeAt(0);
      return code >= 64 && code <= 95 ? String.fromCharCode(code - 64) : data;
    }


    // Runtime recovery is independent of session storage and other demos on this origin.
    async function forgetAndReload() {
      const scope = new URL("./", location.href).href;
      try {
        const registration = await navigator.serviceWorker?.getRegistration(scope);
        if (registration?.scope === scope) await registration.unregister();
        sessionStorage.removeItem(isolationKey);
      } catch {}
      location.reload();
    }
  })().catch(error => {
    document.getElementById("status").textContent = `failed: ${error.message || error}`;
    document.getElementById("status").dataset.state = "error";
  });
  </script>
</body>
</html>
