<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <link rel="stylesheet" href="xterm/xterm.css">
  <style>
    html, body { height: 100%; margin: 0; background: #000; }
    body { display: flex; flex-direction: column; font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    /* The strip: what this window is, and that it's a sandbox */
    #strip { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem 1.25rem; padding: .45rem .75rem;
      background: #fff; color: #0d0d0d; border-bottom: 1px solid #0d0d0d; }
    #strip .name { font-weight: 700; }
    #strip .facts { color: #5a5a57; }
    #status { margin-left: auto; font-variant-numeric: tabular-nums; }
    #status::before { content: ""; display: inline-block; width: .55em; height: .55em; margin-right: .45em;
      border-radius: 50%; background: #c48a1e; vertical-align: .05em; }
    #status[data-state="ready"]::before { background: #d6300c; animation: live 2s ease-in-out infinite; }
    @keyframes live { 50% { opacity: .35; } }
    @media (prefers-reduced-motion: reduce) { #status[data-state="ready"]::before { animation: none; } }
    #terminal { flex: 1; min-height: 0; padding: 4px; }
    @media (prefers-color-scheme: dark) {
      #strip { background: #0d0d0c; color: #ecece8; border-bottom-color: #2b2b29; }
      #strip .facts { color: #a2a29c; }
      #status[data-state="ready"]::before { background: #ff5a2e; }
    }
    /* ?embed: the page hosting this run already says what it is */
    .embed #strip { display: none; }
  </style>
  <script src="xterm/xterm.js"></script>
  <script src="xterm/addon-fit.js"></script>
  <script src="v86/libv86.js"></script>
</head>
<body>
  <header id="strip">
    <span class="name">{{.Title}}</span>
    <span class="facts">sandboxed in this tab · no server · no network</span>
    <span id="status" role="status" data-state="loading">loading 0%</span>
  </header>
  <div id="terminal"></div>
  <script>
    const status = document.getElementById("status");

    // Rendered by snowglobe. Everything below must match build-state.mjs:
    // the snapshot is only valid for the same RAM size and devices
    const emulator = new V86({
      wasm_path: "v86/v86.wasm",
      memory_size: {{.MemoryMB}} * 1024 * 1024,
      vga_memory_size: 8 * 1024 * 1024,
      bios: { url: "bios/seabios.bin" },
      vga_bios: { url: "bios/vgabios.bin" },
      filesystem: {
        basefs: "system/filesystem.json",
        baseurl: "system/filesystem/",
      },
      initial_state: { url: "system/state.bin.zst" },
      // The app runs on the virtio console (hvc0), rendered with xterm.js
      virtio_console: {
        type: "xtermjs",
        container: document.getElementById("terminal"),
        xterm_lib: Terminal,
      },
      disable_speaker: true,
      autostart: true,
    });

    const embedded = new URLSearchParams(location.search).has("embed");
    if (embedded) document.documentElement.classList.add("embed");

    // Tell any snowglobe page on this origin (an index of several runs) what this window is doing
    const run = {
      embedded,
      id: crypto.randomUUID?.() ?? String(Math.random()).slice(2),
      title: document.title,
      path: location.pathname,
      state: "loading",
      progress: 0,
      openedAt: Date.now(),
      readyAt: null,
    };
    const runs = "BroadcastChannel" in window ? new BroadcastChannel("snowglobe-runs") : null;
    const announce = () => runs?.postMessage({ type: "run", run, at: Date.now() });
    runs?.addEventListener("message", ({ data }) => {
      if (data?.type === "hello") announce();
      if (data?.type === "close" && data.id === run.id) window.close();
    });
    setInterval(announce, 2000);
    addEventListener("pagehide", () => runs?.postMessage({ type: "run", run: { ...run, state: "closed" }, at: Date.now() }));
    announce();

    const setStatus = (state, text) => {
      run.state = state;
      status.dataset.state = state;
      status.textContent = text;
      announce();
    };

    emulator.add_listener("download-progress", (e) => {
      if (e.file_name.endsWith("state.bin.zst") && e.lengthComputable) {
        run.progress = Math.round((e.loaded / e.total) * 100);
        setStatus("loading", `loading ${run.progress}%`);
      }
    });

    // The app's console output up to the snapshot, so the terminal shows what it printed
    const screen = fetch("system/console.bin").then((r) => (r.ok ? r.arrayBuffer() : null));

    emulator.add_listener("emulator-started", async () => {
      run.readyAt = Date.now();
      setStatus("ready", "running");

      const term = emulator.virtio_console_adapter.term;
      const replay = await screen;
      if (replay) term.write(new Uint8Array(replay));

      // Size the terminal to the window and tell the guest, so the app wraps lines correctly
      const fit = new FitAddon.FitAddon();
      term.loadAddon(fit);
      const resize = () => {
        fit.fit();
        // v86 0.5.462 forwards this pair as-is into Linux's resize message, which is
        // rows-first, so pass rows first for the guest to see the right size
        emulator.bus.send("virtio-console0-resize", [term.rows, term.cols]);
      };
      window.addEventListener("resize", resize);
      resize();

      queueInput(term);
      term.focus();

      preloadWarmPack();
    });

    // The guest's files are fetched one blocking request at a time the first time each is read.
    // warm.pack bundles the files the app is most likely to need so they arrive in a single
    // background download and land in v86's file cache before the guest asks for them.
    async function preloadWarmPack() {
      const storage = emulator.fs9p?.storage;
      if (!storage?.cache || !storage.storage?.read) return; // v86 internals changed: skip

      // v86 evicts a file from its cache whenever the guest closes it, so every reopen (BEAM
      // reading docs, a new process loading a .so) goes back to the network. Blobs are immutable
      // and the set the guest touches is small, so keep them for the whole session.
      storage.uncache = () => {};

      const response = await fetch("system/warm.pack");
      if (!response.ok) return;
      const pack = new Uint8Array(await response.arrayBuffer());
      const indexSize = new DataView(pack.buffer).getUint32(0, true);
      const index = JSON.parse(new TextDecoder().decode(pack.subarray(4, 4 + indexSize)));

      let offset = 4 + indexSize;
      for (const [name, size, length] of index) {
        const blob = pack.subarray(offset, offset + length);
        offset += length;
        if (await storage.storage.read(name, 0, 0)) continue; // the guest already loaded it
        await storage.cache(name, new Uint8Array(storage.zstd_decompress(size, blob)));
        // Yield between files so typing stays responsive while the cache fills
        await new Promise((resolve) => setTimeout(resolve, 0));
      }
    }

    // v86 (0.5.462) drops console input when the guest has no receive buffer queued, which loses
    // keystrokes when typing fast or pasting. Queue input here and only send it when one is free.
    const encoder = new TextEncoder();
    let pending = [];
    let rx = null;

    function queueInput(term) {
      rx = emulator.v86?.cpu?.devices?.virtio_console?.virtio?.queues?.[0];
      if (!rx) return; // internals moved in a newer v86: keep its default (lossy) input
      emulator.virtio_console_adapter.on_data_disposable.dispose();
      term.onData((data) => sendInput(encoder.encode(data)));
    }

    function sendInput(bytes) {
      // One guest buffer per send; keep chunks small so each fits
      for (let i = 0; i < bytes.length; i += 64) pending.push(bytes.subarray(i, i + 64));
      pump();
    }

    function pump() {
      while (pending.length && (!rx || rx.has_request())) {
        emulator.bus.send("virtio-console0-input-bytes", pending.shift());
      }
      if (pending.length) setTimeout(pump, 5);
    }
  </script>
</body>
</html>
